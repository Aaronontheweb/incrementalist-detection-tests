<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetLibVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="appsettings.json" />
    <!-- Lives outside every project directory, so containment cannot attribute it.
         Only the AdditionalFiles adapter can. -->
    <AdditionalFiles Include="../../build/shared-settings.json" />
  </ItemGroup>

</Project>
